// The comment relay's Cloudflare Worker (see CLAUDE.md, "Comment relay"). `pnpm worker:deploy` deploys it as `rec`,
// at https://rec.zevnda.workers.dev (RELAY_URL in src/shared/relay.ts).
//
// Secrets (`pnpm worker:secret <NAME>`, never in the repo): TURNSTILE_SECRET, GOOGLE_SERVICE_ACCOUNT (the
// comment-relay service account's JSON key), IP_KEY_SECRET (random, 32+ characters). For `pnpm worker:dev`, put
// them in worker/.dev.vars (git-ignored; see .dev.vars.example).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rec",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The embed's script (embed.js), built by `pnpm build` into dist/relay and served as a static asset before the
  // Worker runs. Build before deploying or `pnpm worker:dev`.
  "assets": { "directory": "../dist/relay", "html_handling": "none", "not_found_handling": "none" },
  // Workers Cache: GET answers with a public Cache-Control (the embed page and its comments, the challenge page) are
  // served from Cloudflare's cache without running the Worker. POSTs (posting, voting, ...) are never cached.
  "cache": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT": "realestatecomments",
    // Public: it's in the challenge page
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVFndbLtODXzlJh",
    "TURNSTILE_HOSTNAME": "rec.zevnda.workers.dev",
  },
}
