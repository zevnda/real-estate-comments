# Firefox Add-ons API credentials for `pnpm sign`
# Create them at https://addons.mozilla.org/developers/addon/api/key/ and copy this file to .env (git-ignored)
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=

# Service account key for `pnpm moderate` (reviewing reported comments). Firebase console → Project settings →
# Service accounts → Generate new private key. Save the JSON outside the repo and put its path here.
FIREBASE_SERVICE_ACCOUNT=C:/Users/you/keys/realestatecomments-firebase-adminsdk.json

# Cloudflare R2, for `pnpm shitrentals upload` (copies ShitRentals review photos to the bucket behind
# rec.cdn-steamgameidler.com). Cloudflare dashboard → R2 → Manage API tokens → Create API token, with
# "Object Read & Write" on that bucket only. The account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
